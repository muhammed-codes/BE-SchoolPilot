# ======================
# Server
# ======================
PORT=9998
NODE_ENV=development

# ======================
# Supabase PostgreSQL
# ======================
DATABASE_URL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Use DATABASE_URL or populate all Supabase DB fields above.

# ======================
# JWT
# ======================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
LEGACY_PARENT_DEFAULT_PASSWORD=

# ======================
# Cloudinary
# ======================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ======================
# Resend (Email)
# ======================
RESEND_API_KEY=

# ======================
# Frontend
# ======================
FRONTEND_URL=http://localhost:9997
CORS_ALLOWED_ORIGINS=


# Optional: absolute path to a Chromium executable for local PDF generation.
PUPPETEER_EXECUTABLE_PATH=
